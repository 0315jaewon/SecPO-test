# Non-secret configuration example. Supply OPENROUTER_API_KEY securely first.
# This configures the attacker and critic only, NOT the victim agent.
export AGENTDOJO_ADAPTIVE_BASE_URL=https://openrouter.ai/api/v1
export AGENTDOJO_ADAPTIVE_API_KEY="${OPENROUTER_API_KEY:?Set OPENROUTER_API_KEY first}"
export AGENTDOJO_ATTACKER_MODEL=z-ai/glm-5.3-flash
export AGENTDOJO_JUDGE_MODEL=deepseek/deepseek-v4.1-flash

# Preserve the released attacker/critic decoding defaults explicitly.
export AGENTDOJO_ATTACKER_TEMPERATURE=0.9
export AGENTDOJO_ATTACKER_TOP_P=0.9
export AGENTDOJO_ATTACKER_REASONING_EFFORT=high
export AGENTDOJO_ATTACKER_MAX_TOKENS=4096
export AGENTDOJO_JUDGE_TEMPERATURE=0.7
export AGENTDOJO_JUDGE_TOP_P=''
export AGENTDOJO_JUDGE_REASONING_EFFORT=''
export AGENTDOJO_JUDGE_MAX_TOKENS=4096

# Explicitly override per-role credentials/endpoints to avoid stale settings.
export AGENTDOJO_ATTACKER_BASE_URL="$AGENTDOJO_ADAPTIVE_BASE_URL"
export AGENTDOJO_JUDGE_BASE_URL="$AGENTDOJO_ADAPTIVE_BASE_URL"
export AGENTDOJO_ATTACKER_API_KEY="$AGENTDOJO_ADAPTIVE_API_KEY"
export AGENTDOJO_JUDGE_API_KEY="$AGENTDOJO_ADAPTIVE_API_KEY"
